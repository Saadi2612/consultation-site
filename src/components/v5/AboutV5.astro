---
import PlaceholderV5 from "./PlaceholderV5.astro";
---

<section class="v5-about" id="v5-about">
  <div class="v5-container v5-about__grid">
    <div class="v5-about__media">
      <PlaceholderV5 class="v5-about__img" lines="a" />
      <span class="v5-script v5-about__sig" aria-hidden="true">Arcadia</span>
    </div>

    <div class="v5-about__body">
      <p class="v5-script">About Us</p>
      <p class="v5-lead">
        Arcadia Events is a design-led studio creating weddings and private gatherings with
        clarity and intention.
      </p>
      <p class="v5-lead">
        Our work focuses on spatial composition, material selection, and the relationship
        between environment and experience.
      </p>

      <figure class="v5-quote">
        <PlaceholderV5 class="v5-quote__img" />
        <div>
          <blockquote>
            “Arcadia was never meant to be just an event. It’s a feeling we carefully shape —
            soft, intentional, and deeply human. We believe the most meaningful moments aren’t
            created by perfection, but by presence, emotion, and the space to truly feel.”
          </blockquote>
          <figcaption>
            <strong>Franklin Boston</strong>
            <span>CEO of Arcadia Events</span>
          </figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>
