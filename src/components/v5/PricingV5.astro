---
import { site } from "../../lib/site";

/* SPEC §9 — each starting figure sits next to the scope it buys. */
const tiers = [
  {
    name: "Consultation",
    figure: "$35",
    unit: " an hour",
    total: "A typical two week scope is 20 to 30 hours, $700 to $1,050",
    buys: "Two weeks of questions and a written scope: feature list, exclusions with reasons, stack, sequence, timeline and price assumptions. Yours whether or not we build it.",
    cta: "Book the call",
    href: site.booking,
  },
  {
    name: "MVP development",
    figure: "$3,499",
    unit: " to start",
    total: "The smallest sensible v0",
    buys: "A web app or a React Native app for iOS and Android: one core workflow, accounts, payments if you charge, transactional email, an admin view, deploys and error reporting. Shipped to real users.",
    cta: "Start a build",
    href: "#contact",
  },
  {
    name: "Product hardening",
    figure: "$1,999",
    unit: " to start",
    total: "Four weeks on a live product",
    buys: "Bug fixing, automated tests, a security pass, performance work and safe deploys on your live product. Four agreed numbers moved and reported weekly, plus a runbook that keeps them there.",
    cta: "Stabilise my product",
    href: "#contact",
  },
];
const pushers = [
  "How many screens your users see, and on how many platforms",
  "How many outside integrations have to work on day one",
  "Whether an existing codebase has to be read and understood first",
  "Compliance requirements, such as SOC 2, HIPAA or GDPR data residency",
  "How much design already exists",
];
---

<section class="v5-section" id="pricing" aria-labelledby="v5-pricing-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">Pricing for software development</p>
        <h2 class="v5-h2" id="v5-pricing-title">Clear starting prices, and <br />exactly what each one buys.</h2>
      </div>
      <p class="v5-head__aside">
        Starting prices describe the smallest sensible version of each engagement. The list
        below says what moves a quote above them.
      </p>
    </header>

    <div class="v5-prices" data-v5-reveal="rise" data-v5-stagger>
      {
        tiers.map((t) => (
          <article class="v5-card v5-price">
            <h3 class="v5-card__n">{t.name}</h3>
            <p class="v5-price__figure">
              {t.figure}
              <span>{t.unit}</span>
            </p>
            <p class="v5-price__total">{t.total}</p>
            <p class="v5-card__body">{t.buys}</p>
            <a class="v5-btn v5-btn--sm v5-price__cta" href={t.href}>{t.cta}</a>
          </article>
        ))
      }
    </div>

    <div class="v5-pricing__foot">
      <div>
        <h3 class="v5-scope__title">What pushes a quote above the starting figure</h3>
        <ul class="v5-scope__list">{pushers.map((i) => <li>{i}</li>)}</ul>
      </div>
      <p class="v5-missing">
        <strong>Missing figure.</strong> $3,499 is the smallest sensible v0. The price of a build
        that genuinely takes the 6 to 8 weeks quoted above has not been set yet.
      </p>
    </div>
  </div>
</section>
