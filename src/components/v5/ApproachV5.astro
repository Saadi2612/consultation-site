---
import PlaceholderV5 from "./PlaceholderV5.astro";

const left = [
  {
    n: "01",
    title: "Structure First",
    body: "Every project starts with carefully defining the underlying structure, determining how the space is organised, how it flows and how it will feel before any styling takes place.",
  },
  {
    n: "03",
    title: "Spatial Clarity",
    body: "We design events that feel balanced and well considered. By considering proportion and flow, the layout guides how people gather, interact, and experience the event.",
  },
];
const right = [
  {
    n: "02",
    title: "Material Restraint",
    body: "Materials and elements are selected with care, focusing on quality and relevance rather than quantity. The materials considered add to a cohesive, understated visual experience.",
  },
  {
    n: "04",
    title: "Composed Atmosphere",
    body: "We shape the overall atmosphere through considered layers of light, texture, and composition. The result is an ambience that feels calm, cohesive, and naturally immersive.",
  },
];
---

<section class="v5-section" id="v5-approach">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-script">Approach</p>
        <h2 class="v5-h2">Every Project Starts<br />With Structure.</h2>
      </div>
      <p class="v5-head__aside">
        Before anything is styled, we define the core layout, flow, and spatial logic. Every
        decision follows a clear structure.
      </p>
    </header>

    <div class="v5-approach">
      <div class="v5-approach__col">
        {
          left.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.n}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
      <PlaceholderV5 class="v5-approach__img" lines="b" tone="light" />
      <div class="v5-approach__col">
        {
          right.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.n}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
