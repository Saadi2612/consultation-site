---
import { site, mailto } from "../../lib/site";

/* SPEC §8 — the section that closes cross-border deals. */
const blocks = [
  {
    h: "Contract and NDA",
    p: "We sign your NDA before the first call, and your contract if you have one. If not, we send a fixed-scope agreement naming the deliverable, milestones, payment schedule and termination terms.",
  },
  {
    h: "IP assignment",
    p: "Everything we write is assigned to you on payment of the milestone it belongs to. No licence-back, no shared ownership. Third-party dependencies keep their own open-source licences, and we list them.",
  },
  {
    h: "Payment and currencies",
    p: "USD, GBP, EUR or AUD, by Wise, Payoneer or a direct SWIFT transfer to a business account in Pakistan. Invoices per milestone, net 7. Never the full amount up front.",
  },
  {
    h: "Channels and cadence",
    p: "Slack Connect or your Discord, plus email for anything that has to be findable in a year. One call a week inside your overlap window, and a written Friday note whether or not the call happens.",
  },
  {
    h: "If you go quiet",
    p: "We finish the current milestone, then pause and tell you, rather than billing into silence. Come back inside 60 days and we pick up at the same rate; after that we re-quote.",
  },
  {
    h: "The time difference",
    p: "PKT is UTC+5 with no daylight saving. London 1pm–9pm PKT covers a full 9-to-5. Berlin 12pm–8pm. New York 6pm–10pm and San Francisco 9pm–1am cover your morning. Sydney 8am–12pm covers your afternoon. These shift by an hour when your clocks change.",
  },
];
---

<section class="v5-section" id="v5-borders" aria-labelledby="v5-borders-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-script">Across borders</p>
        <h2 class="v5-h2" id="v5-borders-title">Hiring two engineers<br />eight time zones away.</h2>
      </div>
      <p class="v5-head__aside">
        Contract, ownership, money, cadence and what happens when it goes wrong. Need it in
        your own paperwork instead? Mail <a class="v5-link" href={mailto}>{site.email}</a>.
      </p>
    </header>

    <div class="v5-borders">
      {
        blocks.map((b) => (
          <article class="v5-card">
            <h3 class="v5-card__title v5-card__title--top">{b.h}</h3>
            <p class="v5-card__body">{b.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
