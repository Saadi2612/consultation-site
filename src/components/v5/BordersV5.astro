---
import { site } from "../../lib/site";

/* SPEC §8 — the section that closes cross-border deals. */
const blocks = [
  {
    h: "Contract and NDA",
    p: "We sign your NDA before the first call, and your contract if you have one. If not, we send a fixed scope agreement naming the deliverable, milestones, payment schedule and termination terms.",
  },
  {
    h: "IP assignment",
    p: "Everything we write is assigned to you on payment of the milestone it belongs to. No licence back, no shared ownership. Third party dependencies keep their own open source licences, and we list them.",
  },
  {
    h: "Payment and currencies",
    p: "USD, GBP, EUR or AUD, by Wise, Payoneer or a direct SWIFT transfer to our business account. Invoices per milestone, net 7. Never the full amount up front.",
  },
  {
    h: "Channels and cadence",
    p: "Slack Connect or your Discord, plus email for anything that has to be findable in a year. One call a week inside your overlap window, and a written Friday note whether or not the call happens.",
  },
  {
    h: "If you go quiet",
    p: "We finish the current milestone, then pause and tell you, rather than billing into silence. Come back inside 60 days and we pick up at the same rate; after that we quote again.",
  },
  {
    h: "The time difference",
    p: "A full working day overlaps with London and Berlin, the morning with New York and San Francisco, and the afternoon with Sydney. Your weekly call always sits inside those shared hours, and we agree the time before work starts.",
  },
];
---

<section class="v5-section" id="v5-borders" aria-labelledby="v5-borders-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">Hiring an offshore development team</p>
        <h2 class="v5-h2" id="v5-borders-title">A remote team, with the <br />paperwork already answered.</h2>
      </div>
      <p class="v5-head__aside">
        Contracts, IP ownership, payments, communication and what happens if something goes wrong. Need it in your own paperwork? Mail Mohib at <a class="v5-link" href={"mailto:" + site.emails[0].address}>{site.emails[0].address}</a> or Saad at <a class="v5-link" href={"mailto:" + site.emails[1].address}>{site.emails[1].address}</a>.
      </p>
    </header>

    <div class="v5-borders" data-v5-reveal="fade">
      {
        blocks.map((b) => (
          <article class="v5-card">
            <h3 class="v5-card__title v5-card__title--top">{b.h}</h3>
            <p class="v5-card__body">{b.p}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
