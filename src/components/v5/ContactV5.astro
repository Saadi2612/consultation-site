---
import { site } from "../../lib/site";
import OverlapV5 from "./OverlapV5.astro";

const states = [
  ["vq", "I have an idea and need a scope and a quote"],
  ["v0", "I have a scope and need an MVP built"],
  ["v1", "My product is live and needs hardening"],
];
const budgets = [
  "Under $1,500 (likely not a fit)",
  "$1,500 to $3,500",
  "$3,500 to $8,000",
  "$8,000 to $20,000",
  "Over $20,000",
];
const timelines = ["Starting now", "Inside a month", "This quarter", "Still deciding"];
const recipients = site.emails.map((e) => e.address).join(",");
---

<section class="v5-contact" id="v5-contact" aria-labelledby="v5-contact-title">
  <div class="v5-container v5-contact__grid">
    <div class="v5-contact__media">
      <OverlapV5 class="v5-contact__img" />
      <div class="v5-team__card v5-contact__book">
        <h3>The faster path</h3>
        <p class="v5-team__bio">
          Skip the form and book a 30 minute call with Mohib, or mail Mohib at{" "}
          <a class="v5-link" href={`mailto:${site.emails[0].address}`}>{site.emails[0].address}</a>{" "}
          or Saad at{" "}
          <a class="v5-link" href={`mailto:${site.emails[1].address}`}>{site.emails[1].address}</a>.
        </p>
        <a class="v5-btn v5-btn--sm" href={site.booking}>Book a 30 minute call with Mohib</a>
      </div>
    </div>

    <form
      class="v5-form"
      name="v5-enquiry"
      method="post"
      enctype="text/plain"
      action={`mailto:${recipients}?subject=Project enquiry`}
      data-v5-form
      data-v5-mailto={recipients}
    >
      <p class="v5-label">Start your project</p>
      <p class="v5-form__kicker">Tell us about your product.</p>
      <h2 class="v5-h2" id="v5-contact-title">A written reply within one working day.</h2>
      <p class="v5-form__intro">
        Share where your product stands, your budget and your timeline. If we are not the right
        team for it, we will say so in the reply and, where we can, recommend someone who is.
      </p>

      <div class="v5-form__row">
        <label class="v5-field">
          <span>Your name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="v5-field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label class="v5-field">
        <span>Company URL</span>
        <input type="url" name="company" placeholder="https://" />
      </label>
      <div class="v5-form__row">
        <label class="v5-field">
          <span>Where you are</span>
          <select name="state" data-v5-state-field>
            {states.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </label>
        <label class="v5-field">
          <span>Budget</span>
          <select name="budget">
            {budgets.map((b) => <option>{b}</option>)}
          </select>
        </label>
      </div>
      <label class="v5-field">
        <span>Timeline</span>
        <select name="timeline">
          {timelines.map((t) => <option>{t}</option>)}
        </select>
      </label>
      <label class="v5-field">
        <span>What would you like us to build or fix?</span>
        <textarea name="detail" rows="4"></textarea>
      </label>

      <button class="v5-btn v5-btn--block" type="submit">Send this to Mohib and Saad</button>

      <p class="v5-form__note" data-v5-form-note aria-live="polite">
        Sending opens your email app with a message to both of us and your answers filled in.
        One of us replies by the end of our next working day.
      </p>
    </form>
  </div>
</section>

<script>
  // Choosing a rail position pre-fills the form. Submitting opens the
  // visitor's email app addressed to both of us, with the answers filled in,
  // so an enquiry is never silently dropped.
  const field = document.querySelector<HTMLSelectElement>("[data-v5-state-field]");
  document.querySelectorAll<HTMLAnchorElement>("[data-v5-state]").forEach((link) => {
    link.addEventListener("click", () => {
      if (field) field.value = link.dataset.v5State ?? field.value;
    });
  });

  const form = document.querySelector<HTMLFormElement>("[data-v5-form]");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? "").trim();
    const state = form.querySelector<HTMLSelectElement>("[name=state]");
    const stateLabel = state?.selectedOptions[0]?.textContent?.trim() ?? "";

    const body = [
      `Name: ${value("name")}`,
      `Email: ${value("email")}`,
      `Company: ${value("company") || "Not given"}`,
      `Where we are: ${stateLabel}`,
      `Budget: ${value("budget")}`,
      `Timeline: ${value("timeline")}`,
      "",
      value("detail"),
    ].join("\n");

    const subject = `Project enquiry from ${value("name")}`;
    window.location.href =
      `mailto:${form.dataset.v5Mailto}` +
      `?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
