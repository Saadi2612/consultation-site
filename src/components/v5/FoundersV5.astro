---
/* SPEC §10 — the team layout, one card per founder. Division of labour is
   the point, because the quiet worry is the bus factor. Both founders are
   full stack; each one leads a side. */
import { Picture } from "astro:assets";
import { site } from "../../lib/site";
import mohibPhoto from "../../assets/founders/mohib-photo.jpg";
import saadPhoto from "../../assets/founders/saad-photo.jpg";

const founders = [
  {
    name: "Mohib",
    photo: mohibPhoto,
    email: site.emails[0].address,
    owns: "Full stack engineer and founder. Leads the backend, DevOps and product hardening.",
    quote: "I write the APIs, the data model and the infrastructure, and I am the one who is paged when production misbehaves. If your pages take two seconds to load or your checkout fails at peak, I find out why, tell you what it costs to fix, and fix it.",
  },
  {
    name: "Saad",
    photo: saadPhoto,
    email: site.emails[1].address,
    owns: "Full stack engineer and founder. Leads the architecture, infrastructure and scalability.",
    quote: "I design how your product fits together: the architecture, the cloud infrastructure and how it scales as more users arrive. I also run the project, so the scope, the Friday note and the demo come from me, and I would rather give you a clear no in week two than a surprise in week six.",
  },
];
---

<section class="v5-section" id="v5-founders" aria-labelledby="v5-founders-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">The engineers behind Proofload</p>
        <h2 class="v5-h2" id="v5-founders-title">Two full stack engineers. You always <br />know who owns your problem.</h2>
      </div>
      <p class="v5-head__aside">
        {site.experience} of building and supporting software for clients.
        We both work across the whole stack and both have access to every project, so your
        product never depends on one person.
      </p>
    </header>

    <div class="v5-team" data-v5-reveal="scale" data-v5-stagger>
      {
        founders.map((f) => (
          <div class="v5-team__lead">
            <Picture
              src={f.photo}
              formats={["avif", "webp"]}
              widths={[400, 700, 1110]}
              sizes="(min-width: 900px) 50vw, 100vw"
              alt={`${f.name}, full stack engineer and founder of Proofload`}
              class="v5-team__img v5-team__photo"
              loading="lazy"
              decoding="async"
            />
            <div class="v5-team__card">
              <h3>{f.name}</h3>
              <p class="v5-team__role">{f.owns}</p>
              <p class="v5-team__bio">{f.quote}</p>
              <a class="v5-link v5-team__mail" href={`mailto:${f.email}`}>{f.email}</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
