---
import { site } from "../../lib/site";
import { domeDefaults, domeDots, domeShadows } from "../../lib/dome";

// The dots behind the rail, computed here at build time and shipped as
// plain CSS: one box-shadow list per dot size.
const dome = domeShadows(domeDots(domeDefaults));

/* SPEC §2 — one instrument with three positions. Every position is fully
   legible with nothing selected; choosing one only pre-fills the form. */
const stages = [
  {
    id: "vq",
    marker: "v?",
    state: "You have the idea. You need a clear plan and a price.",
    service: "Consultation, two weeks",
    deliverable: "A written product scope, technical plan and quote you can hand to any team.",
    price: "$35 an hour, usually $700 to $1,050 in total",
    cta: "Book the scoping call",
    href: site.booking,
  },
  {
    id: "v0",
    marker: "v0",
    state: "The plan is ready. Nothing is built yet.",
    service: "MVP development, 6 to 8 weeks",
    deliverable: "A working web or mobile MVP that real users can sign into and pay for.",
    price: "From $3,499",
    cta: "Plan your MVP",
    href: "#v5-contact",
  },
  {
    id: "v1",
    marker: "v1",
    state: "It is live, and it keeps breaking.",
    service: "Product hardening, four weeks",
    deliverable: "Bugs fixed, every key flow tested, and a product ready to market.",
    price: "From $1,999",
    cta: "Stabilise my product",
    href: "#v5-contact",
  },
];
---

<section class="v5-hero" id="v5-top" aria-labelledby="v5-hero-title">
  <div class="v5-container">
    <div class="v5-hero__head">
      <div>
        <p class="v5-label">Product hardening and full stack development</p>
        <h1 class="v5-display" id="v5-hero-title">We make your software<br />stable, tested and live.</h1>
      </div>
      <p class="v5-hero__aside">
        Mohib and Saad, two full stack engineers with {site.experience} building websites, web apps
        and iOS and Android apps. Tell us where your product stands today.
        <a class="v5-btn v5-btn--sm v5-hero__book" href={site.booking}>Book a 30 minute call</a>
      </p>
    </div>

    <div class="v5-rail" id="v5-rail">
      <div class="v5-art" aria-hidden="true">
        <span class="v5-art__field">
          {
            dome.map((b) => (
              <i
                class="v5-art__dots"
                style={`--v5-dot:${b.size.toFixed(3)}cqw;box-shadow:${b.shadow}`}
              />
            ))
          }
        </span>
        <span class="v5-art__blur v5-art__blur--1"></span>
        <span class="v5-art__blur v5-art__blur--2"></span>
        <span class="v5-art__blur v5-art__blur--3"></span>
        <span class="v5-art__blur v5-art__blur--4"></span>
        <span class="v5-art__blur v5-art__blur--5"></span>
        <span class="v5-art__blur v5-art__blur--6"></span>
        <span class="v5-art__grain"></span>
      </div>
      <span class="v5-ph__frame" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      {
        stages.map((s) => (
          <article class="v5-stage">
            <p class="v5-stage__marker">{s.marker}</p>
            <div class="v5-stage__copy">
              <h2 class="v5-stage__state">{s.state}</h2>
              <p class="v5-stage__service">{s.service}</p>
              <p class="v5-stage__deliverable">{s.deliverable}</p>
              <p class="v5-stage__price">{s.price}</p>
              <a class="v5-btn v5-btn--sm v5-stage__cta" href={s.href} data-v5-state={s.id}>
                {s.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
