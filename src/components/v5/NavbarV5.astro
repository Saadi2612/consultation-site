---
import { site } from "../../lib/site";
---

<header class="v5-header">
  <div class="v5-container v5-header__inner">
    <a class="v5-logo" href="#top" aria-label="Proofload home">
      <span class="v5-logo__mark" aria-hidden="true">
        <svg viewBox="0 0 20 20"><path d="M10 2 L12 8 L18 10 L12 12 L10 18 L8 12 L2 10 L8 8 Z" /></svg>
      </span>
      {site.name}
    </a>

    <nav class="v5-nav" aria-label="Sections">
      <a href="#services">Services</a>
      <a href="#hardening">Product hardening</a>
      <a href="#pricing">Pricing</a>
      <a href="#founders">Team</a>
      <a href="#faq">FAQ</a>
    </nav>

    <a class="v5-btn v5-btn--sm" href={site.booking}>Book a call</a>
  </div>
</header>
