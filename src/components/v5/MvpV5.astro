---
/* SPEC §4b — the scope table. The right column is the section. */
const ships = [
  "Accounts, sign in and password reset",
  "The one workflow customers pay for",
  "Payments, if you charge from day one",
  "Transactional email that reaches inboxes",
  "An admin view you can run support from",
  "Deploys, backups and error reporting",
];
const cut = [
  ["Web and mobile on day one", "Launch on the platform your users are already on. The second follows once the first has traction, sharing the same API."],
  ["Messaging inside the app", "Email carries it until you have the volume to justify a thread model."],
  ["Reviews and ratings", "Needs both sides of a market to exist before it means anything."],
  ["A custom analytics dashboard", "For the first hundred users, a hosted analytics tool and a few saved queries answer every question you will have."],
  ["More than one currency", "One currency until a second country actually asks."],
  ["Roles beyond admin and user", "A permission matrix invented before anyone has asked for it is a month of rework."],
];
---

<section class="v5-section" id="v5-mvp" aria-labelledby="v5-mvp-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">MVP development from $3,499</p>
        <h2 class="v5-h2" id="v5-mvp-title">A startup MVP ships on time when<br />half the ideas wait for version two.</h2>
      </div>
      <p class="v5-head__aside">
        Six to eight weeks to a web app or mobile app that real users can sign into and pay for. The column on the right is where that date comes from.
      </p>
    </header>

    <div class="v5-scope" data-v5-reveal="fade">
      <div class="v5-scope__col v5-scope__col--ships">
        <h3 class="v5-scope__title">Ships in v0</h3>
        <ul class="v5-scope__list">
          {ships.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="v5-scope__col v5-scope__col--cut">
        <h3 class="v5-scope__title">Left out on purpose, and why</h3>
        <dl class="v5-scope__cut">
          {
            cut.map(([item, why]) => (
              <div>
                <dt>{item}</dt>
                <dd>{why}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
