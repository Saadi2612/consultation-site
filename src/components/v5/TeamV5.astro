---
import PlaceholderV5 from "./PlaceholderV5.astro";
---

<section class="v5-section" id="v5-team">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-script">Founders</p>
        <h2 class="v5-h2">Behind The Arcadia Team</h2>
      </div>
      <p class="v5-head__aside">
        The team brings a shared sensitivity to space and atmosphere, working across
        planning, design, and production to shape every event with care.
      </p>
    </header>

    <div class="v5-team">
      <div class="v5-team__lead">
        <PlaceholderV5 class="v5-team__img" frame tone="dark" />
        <div class="v5-team__card">
          <h3>Franklin Boston</h3>
          <p class="v5-team__role">Founder &amp; Design Director</p>
          <p class="v5-team__bio">
            Working at the intersection of space, material, and experience, shaping events
            through structure and atmosphere.
          </p>
        </div>
      </div>
      <PlaceholderV5 class="v5-team__img" tone="mid" />
      <PlaceholderV5 class="v5-team__img" tone="light" />
      <PlaceholderV5 class="v5-team__img" tone="dark" />
    </div>
  </div>
</section>
