---
/* What we build, named the way a founder searches for it. Hardening leads
   because it is the work we are best known for; the rest is the full stack
   we cover from first screen to production server. */
const services = [
  {
    title: "Website development",
    body: "Fast, search friendly marketing sites and content platforms built with Next.js and React, with clean markup, structured data and the Core Web Vitals scores that search engines reward.",
  },
  {
    title: "Web application development",
    body: "Dashboards, portals, marketplaces and SaaS products with a React or Next.js front end and a Node.js or Django back end, on a Postgres database designed to grow with you.",
  },
  {
    title: "iOS and Android app development",
    body: "Cross platform mobile apps in React Native that ship to the App Store and Google Play from one codebase, sharing the API and business logic with your web product.",
  },
  {
    title: "MVP development for startups",
    body: "A first version real users can sign into in six to eight weeks, scoped down to the one workflow that proves the idea, then built so it does not need rewriting at the first sign of traction.",
  },
  {
    title: "DevOps and production systems",
    body: "Cloud setup on AWS, Docker, CI/CD pipelines, staging environments, backups, logging and error tracking, so releases are routine and outages are rare and short.",
  },
  {
    title: "AI features and integrations",
    body: "Practical AI inside your product using the Claude, Gemini and ChatGPT APIs: document search, support assistants, content generation and data extraction, with cost and accuracy measured rather than guessed.",
  },
];

const points = [
  "Bug fixing and code audit",
  "Automated test coverage",
  "Performance and load tuning",
  "Security review and fixes",
  "CI/CD, monitoring and alerts",
  "Launch and 30 days of support",
];

const stack = [
  "Next.js", "React", "React Native", "Node.js", "Django", "Python", "TypeScript",
  "PostgreSQL", "AWS", "Docker", "Claude", "Gemini", "ChatGPT",
];
---

<section class="v5-section" id="v5-services" aria-labelledby="v5-services-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">Full stack development services</p>
        <h2 class="v5-h2" id="v5-services-title">From the first screen to a <br />stable production system.</h2>
      </div>
      <p class="v5-head__aside">
        Websites, web apps and iOS and Android apps, built and maintained by the same two
        engineers. No hand offs between agencies, and no part of your product that nobody on
        the team understands.
      </p>
    </header>

    <div data-v5-reveal="wipe">
    <article class="v5-card v5-service-lead">
      <div>
        <p class="v5-card__n">What we are known for</p>
        <h3 class="v5-service-lead__title">Product hardening for live software</h3>
        <p class="v5-service-lead__body">
          Your product is already in front of customers, and it keeps breaking. We audit the
          codebase, fix the bugs that cost you users, add automated tests around the flows that
          take money, tighten security, speed up slow pages and APIs, and set up deploys and
          monitoring you can trust. You get a product that is fully tested and ready to market.
        </p>
        <a class="v5-btn v5-btn--sm v5-service-lead__cta" href="#v5-hardening">See how hardening works</a>
      </div>
      <ul class="v5-scope__list v5-service-lead__points">
        {points.map((p) => <li>{p}</li>)}
      </ul>
    </article>
    </div>

    <div class="v5-services" data-v5-reveal="rise" data-v5-stagger>
      {
        services.map((s) => (
          <article class="v5-card">
            <h3 class="v5-card__title v5-card__title--top">{s.title}</h3>
            <p class="v5-card__body">{s.body}</p>
          </article>
        ))
      }
    </div>

    <p class="v5-stack">
      <strong>Technologies we work in every week:</strong> {stack.join(", ")}.
    </p>
  </div>
</section>
