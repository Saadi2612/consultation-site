---
import PlaceholderV5 from "./PlaceholderV5.astro";

/* SPEC §3 — four operating facts, nothing adjectival, nothing invented.
   Tagged rather than numbered: they are not a sequence. */
const left = [
  {
    tag: "Overlap",
    title: "Your working hours, not ours",
    body: "We overlap with your day wherever you are. London 1pm to 9pm PKT, Berlin 12pm to 8pm, New York 6pm to 10pm, San Francisco 9pm to 1am and Sydney 8am to 12pm. These move by an hour when your clocks change; ours never do.",
  },
  {
    tag: "Ownership",
    title: "You own the code at every milestone",
    body: "Every milestone is yours the moment it is paid for: repository, history and deploy configuration. Nothing is held back until the final invoice clears.",
  },
];
const right = [
  {
    tag: "Response",
    title: "A written reply inside one working day",
    body: "Messages sent during your overlap window get answered in it. Anything sent outside it is answered by the end of our next working day.",
  },
  {
    tag: "Paperwork",
    title: "We sign your NDA first",
    body: "Send your NDA and we sign it before the first call. If you do not have one, we send ours. Your idea and your codebase stay confidential from the first message.",
  },
];
---

<section class="v5-section" aria-labelledby="v5-facts-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">How we work with clients</p>
        <h2 class="v5-h2" id="v5-facts-title">Four commitments you<br />can hold us to.</h2>
      </div>
      <p class="v5-head__aside">
        Working with a remote development team should feel as dependable as one down the hall. If any of these stops being true, it comes off this page.
      </p>
    </header>

    <div class="v5-approach" data-v5-reveal="rise" data-v5-stagger>
      <div class="v5-approach__col">
        {
          left.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.tag}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
      <PlaceholderV5
        class="v5-approach__img"
        lines="b"
        tone="light"
        label="Photograph: Mohib and Saad at work in Lahore"
      />
      <div class="v5-approach__col">
        {
          right.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.tag}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
