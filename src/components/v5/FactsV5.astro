---
import PlaceholderV5 from "./PlaceholderV5.astro";

/* SPEC §3 — four operating facts, nothing adjectival, nothing invented.
   Tagged rather than numbered: they are not a sequence. */
const left = [
  {
    tag: "Overlap",
    title: "Your working hours, not ours",
    body: "London 1pm–9pm PKT. Berlin 12pm–8pm. New York 6pm–10pm. San Francisco 9pm–1am. Sydney 8am–12pm. These shift by an hour when your region changes clocks; ours never does.",
  },
  {
    tag: "Ownership",
    title: "Code transfers at each milestone",
    body: "Every milestone is yours the moment it is paid for: repository, history and deploy configuration. Not held back until the final invoice clears.",
  },
];
const right = [
  {
    tag: "Response",
    title: "An answer inside one working day",
    body: "Messages sent during your overlap window get answered in it. Anything sent outside it is answered by the end of our next working day.",
  },
  {
    tag: "Paperwork",
    title: "We sign your NDA",
    body: "Send yours and we sign it before the first call. If you do not have one, we send ours. You never have to produce a document to start a conversation.",
  },
];
---

<section class="v5-section" aria-labelledby="v5-facts-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">Ground truth</p>
        <h2 class="v5-h2" id="v5-facts-title">Four things you<br />can hold us to.</h2>
      </div>
      <p class="v5-head__aside">
        Facts rather than adjectives. If any of these stops being true, the sentence comes off
        the page.
      </p>
    </header>

    <div class="v5-approach">
      <div class="v5-approach__col">
        {
          left.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.tag}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
      <PlaceholderV5
        class="v5-approach__img"
        lines="b"
        tone="light"
        label="Photograph: Mohib and Saad at work in Lahore"
      />
      <div class="v5-approach__col">
        {
          right.map((c) => (
            <article class="v5-card">
              <span class="v5-card__n">{c.tag}</span>
              <h3 class="v5-card__title">{c.title}</h3>
              <p class="v5-card__body">{c.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
