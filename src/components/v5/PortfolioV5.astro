---
/* Selected work: one card per project saying what it is and what the
   screens show. The first two are set larger, so the grid reads as two
   featured projects and three more. */
import { Picture } from "astro:assets";
import { site } from "../../lib/site";
import { portfolio } from "../../lib/portfolio";
---

<section class="v5-section v5-work" id="v5-work" aria-labelledby="v5-work-title">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-label">Selected work</p>
        <h2 class="v5-h2" id="v5-work-title">Products we have designed <br />and built for clients.</h2>
      </div>
      <p class="v5-head__aside">
        Healthcare booking, fintech and youth finance products, from marketing sites to full web
        apps. Each one designed, built and launched by the same two engineers you would work with.
      </p>
    </header>

    <div class="v5-projects" data-v5-reveal="rise" data-v5-stagger>
      {
        portfolio.map((p, i) => (
          <article class:list={["v5-project", i < 2 && "v5-project--wide"]}>
            <div class="v5-project__media">
              <Picture
                src={p.image}
                formats={["avif", "webp"]}
                widths={[480, 800, p.image.width].filter((w, n, a) => w <= p.image.width && a.indexOf(w) === n)}
                quality={90}
                sizes={i < 2 ? "(min-width: 860px) 50vw, 100vw" : "(min-width: 860px) 33vw, 100vw"}
                alt={p.alt}
                class="v5-project__img"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="v5-project__body">
              <p class="v5-card__n">{p.kind}</p>
              <h3 class="v5-project__name">{p.name}</h3>
              <p class="v5-card__body">{p.body}</p>
              <ul class="v5-project__tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="v5-work__cta">
      <p>Want to see the code, a live demo or more work in your industry?</p>
      <a class="v5-btn v5-btn--sm" href={site.booking}>Ask us on a 30 minute call</a>
    </div>
  </div>
</section>
