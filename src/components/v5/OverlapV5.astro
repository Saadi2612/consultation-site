---
/* When we are both working: each client region's shared hours, shown in
   that region's own local time so a reader never has to convert. The
   windows match the overlap commitment and the cross border section. */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

// Local hours on a 24 hour clock, in the client's own time zone.
const AXIS_START = 8;
const AXIS_END = 18;
const regions = [
  { city: "London", from: 9, to: 17, label: "9am to 5pm" },
  { city: "Berlin", from: 9, to: 17, label: "9am to 5pm" },
  { city: "New York", from: 9, to: 13, label: "9am to 1pm" },
  { city: "San Francisco", from: 9, to: 13, label: "9am to 1pm" },
  { city: "Sydney", from: 13, to: 17, label: "1pm to 5pm" },
];
const span = AXIS_END - AXIS_START;
const ticks = [8, 10, 12, 14, 16, 18];
const tickLabel = (h: number) => (h === 12 ? "12pm" : h > 12 ? `${h - 12}pm` : `${h}am`);
---

<figure class:list={["v5-overlap", className]} aria-label="Hours we share with each client region, in local time">
  <div class="v5-overlap__inner" data-v5-reveal="slide" data-v5-stagger>
    <header class="v5-overlap__head">
      <span class="v5-overlap__kicker">Shared hours, in your local time</span>
      <span class="v5-overlap__title">We work inside your day</span>
    </header>

    <ul class="v5-overlap__rows">
      {
        regions.map((r) => (
          <li class="v5-overlap__row">
            <span class="v5-overlap__city">{r.city}</span>
            <span class="v5-overlap__track">
              <i
                style={`left:${((r.from - AXIS_START) / span) * 100}%;width:${((r.to - r.from) / span) * 100}%`}
              />
            </span>
            <span class="v5-overlap__time">{r.label}</span>
          </li>
        ))
      }
    </ul>

    <div class="v5-overlap__axis" aria-hidden="true">
      <span class="v5-overlap__city"></span>
      <span class="v5-overlap__ticks">
        {
          ticks.map((t) => (
            <span style={`left:${((t - AXIS_START) / span) * 100}%`}>{tickLabel(t)}</span>
          ))
        }
      </span>
      <span class="v5-overlap__time"></span>
    </div>

    <p class="v5-overlap__note">Times move by an hour when your clocks change.</p>
  </div>
</figure>
