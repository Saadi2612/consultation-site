---
import PlaceholderV5 from "./PlaceholderV5.astro";
---

<section class="v5-section v5-gallery-sec" id="v5-gallery">
  <div class="v5-container">
    <header class="v5-head v5-head--center">
      <p class="v5-script">Our Gallery</p>
      <h2 class="v5-h2">We Take on a Limited Number<br />of Projects Each Season.</h2>
      <p class="v5-head__aside">
        This allows us to stay closely involved in every project. Each event is given the time
        and space it deserves, from concept to final detail.
      </p>
    </header>
  </div>

  <div class="v5-gallery" aria-label="Gallery">
    <PlaceholderV5 class="v5-gallery__edge" tone="mid" />
    <div class="v5-gallery__stack">
      <PlaceholderV5 tone="light" />
      <PlaceholderV5 tone="dark" />
    </div>
    <PlaceholderV5 class="v5-gallery__center" tone="dark" />
    <div class="v5-gallery__stack">
      <PlaceholderV5 tone="light" />
      <PlaceholderV5 tone="mid" />
    </div>
    <PlaceholderV5 class="v5-gallery__edge" tone="mid" />
  </div>
</section>
