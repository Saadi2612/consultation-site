---
import { site } from "../../lib/site";

const services = [
  "Product hardening",
  "MVP development",
  "Web application development",
  "iOS and Android apps",
  "Website development",
  "DevOps and AI integrations",
];
---

<footer class="v5-footer">
  <div class="v5-container">
    <div class="v5-footer__top">
      <div class="v5-footer__brand">
        <span class="v5-logo__mark" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="M10 2 L12 8 L18 10 L12 12 L10 18 L8 12 L2 10 L8 8 Z" /></svg>
        </span>
        <p>Two engineers. <br />Products that stay up.</p>
      </div>

      <nav class="v5-footer__cols" aria-label="Footer">
        <div>
          <h3>Services</h3>
          {services.map((s) => <a href="#services">{s}</a>)}
        </div>
        <div>
          <h3>Contact</h3>
          {site.emails.map((e) => <a href={`mailto:${e.address}`}>{e.name}: {e.address}</a>)}
          <a href={site.booking}>Book a 30 minute call</a>
        </div>
        <div>
          <h3>Studio</h3>
          <p>Remote, working your hours</p>
          <p>Clients in the US, UK, Europe and Australia</p>
        </div>
      </nav>
    </div>

    <p class="v5-wordmark" aria-hidden="true">{site.name}</p>
  </div>
</footer>
