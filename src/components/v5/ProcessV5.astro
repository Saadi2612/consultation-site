---
import PlaceholderV5 from "./PlaceholderV5.astro";

const steps = [
  {
    title: "Direction",
    body: "We begin by understanding the intent behind the event, the setting, and the feeling it should leave behind.",
  },
  {
    title: "Spatial Planning",
    body: "We shape the layout and flow, defining how the space is experienced and how each moment unfolds.",
  },
  {
    title: "Material & Atmosphere",
    body: "We select materials, textures, and tones that support the overall atmosphere.",
  },
  {
    title: "Design Development",
    body: "Layouts and details are refined until every element works together as a single composition.",
  },
  {
    title: "Delivery",
    body: "We oversee installation on the day, so the space arrives exactly as it was designed.",
  },
];
---

<section class="v5-section" id="v5-process">
  <div class="v5-container">
    <header class="v5-head">
      <div>
        <p class="v5-script">Process</p>
        <h2 class="v5-h2">We Establish Direction Through Spatial<br />and Visual Frameworks Design.</h2>
      </div>
      <p class="v5-head__aside">
        We move from broad direction to detailed design, defining the space step by step so
        every decision builds on the one before it.
      </p>
    </header>

    <div class="v5-process">
      <PlaceholderV5 class="v5-process__img" lines="c" tone="dark" />
      <ol class="v5-process__list" tabindex="0" aria-label="Process steps">
        {
          steps.map((s) => (
            <li class="v5-step">
              <h3 class="v5-step__title">{s.title}</h3>
              <p class="v5-step__body">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
