---
const measures = [
  { name: "p95 API response", before: "2.4 seconds at peak", after: "Under 300ms" },
  { name: "Error rate", before: "Around 3%", after: "Under 0.5%" },
  { name: "Tests", before: "No test suite", after: "140 integration tests" },
  { name: "Deploys", before: "Monthly, by hand", after: "Daily, automated" },
];
---

<section class="v3-section v3-section-tint" id="numbers" aria-labelledby="v3-numbers-title">
  <div class="v3-container v3-split">
    <div class="v3-split-head">
      <h2 class="v3-display-2" id="v3-numbers-title">
        Four numbers have to move before we call it stable.
      </h2>
      <p class="v3-body v3-on-light-secondary v3-numbers-lede">
        These figures are illustrative, from one four-week hardening sprint.
        They are not an average and not a promise.
      </p>
    </div>

    <div class="v3-card v3-numbers-card" data-v3-reveal>
      <table class="v3-numbers">
        <thead>
          <tr>
            <th scope="col"><span class="v3-visually-hidden">Measure</span></th>
            <th scope="col">On arrival</th>
            <th scope="col">After four weeks</th>
          </tr>
        </thead>
        <tbody>
          {
            measures.map((m) => (
              <tr>
                <th scope="row">{m.name}</th>
                <td class="v3-before" data-label="On arrival:">{m.before}</td>
                <td class="v3-after" data-label="After four weeks:">{m.after}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .v3-numbers-lede {
    margin-top: var(--v3-space-4);
    max-width: 38ch;
  }

  .v3-numbers-card {
    padding-block: var(--v3-space-2);
  }

  .v3-numbers {
    width: 100%;
    border-collapse: collapse;
  }

  .v3-numbers th,
  .v3-numbers td {
    text-align: left;
    padding: var(--v3-space-6) var(--v3-space-3);
    font-size: var(--v3-ui-small);
    line-height: 20px;
    font-weight: var(--v3-w-body);
  }

  .v3-numbers th:first-child,
  .v3-numbers td:first-child {
    padding-left: 0;
  }

  .v3-numbers th:last-child,
  .v3-numbers td:last-child {
    padding-right: 0;
  }

  .v3-numbers thead th {
    font-size: var(--v3-small);
    line-height: var(--v3-small-lh);
    font-weight: var(--v3-w-small);
    color: #55555f;
  }

  .v3-numbers tbody tr {
    border-top: 1px solid var(--v3-border-subtle);
  }

  .v3-before {
    color: #55555f;
  }

  .v3-after {
    color: var(--v3-text-primary);
  }

  /* §8 asks multi-column content to collapse rather than scroll sideways, so
     below 768px each measure becomes its own block with the two columns
     labelled in place. */
  @media (max-width: 767px) {
    .v3-numbers thead {
      display: none;
    }

    .v3-numbers tbody tr,
    .v3-numbers tbody th,
    .v3-numbers tbody td {
      display: block;
      padding-inline: 0;
    }

    .v3-numbers tbody tr {
      padding-block: var(--v3-space-4);
    }

    .v3-numbers tbody th {
      font-family: var(--v3-font-display);
      font-size: var(--v3-body);
      line-height: var(--v3-body-lh);
      font-weight: var(--v3-w-display);
      padding-bottom: var(--v3-space-2);
    }

    .v3-numbers tbody td {
      padding-block: var(--v3-space-1);
    }

    .v3-numbers tbody td::before {
      content: attr(data-label) " ";
      color: #55555f;
    }
  }
</style>
