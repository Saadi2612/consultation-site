---
const ships = [
  "One way to sign in, not social logins and SSO",
  "The single flow the product is paid for",
  "Card payments, if money changes hands in v0",
  "A web app that works in a phone browser",
];
---

<section class="v3-section v3-section-light" id="decision" aria-labelledby="v3-decision-title">
  <div class="v3-container v3-split">
    <div class="v3-split-head">
      <h2 class="v3-display-2" id="v3-decision-title">
        Half of scoping a v0 is deciding what not to build.
      </h2>
    </div>

    <div>
      <p class="v3-body v3-on-light-secondary v3-decision-lede">
        Everything left off this list waits for real usage to justify it:
        native apps, multi-currency, an analytics dashboard, the second and
        third flows. All cheaper to build once you've watched people use the
        first one.
      </p>

      <p class="v3-small v3-decision-label">What a v0 ships with</p>

      <ul class="v3-checklist">
        {
          ships.map((item, i) => (
            <li data-v3-fade data-v3-delay={i * 60}>
              <svg class="v3-tick" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8.5 6.2 12 13 4.5" />
              </svg>
              <span class="v3-body">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .v3-decision-lede {
    max-width: 58ch;
  }

  .v3-decision-label {
    margin-top: var(--v3-space-8);
    margin-bottom: var(--v3-space-2);
    color: #55555f;
  }

  .v3-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .v3-checklist li {
    display: flex;
    align-items: flex-start;
    gap: var(--v3-space-3);
    padding-block: var(--v3-space-4);
    border-top: 1px solid var(--v3-border-subtle);
  }

  .v3-checklist li:last-child {
    border-bottom: 1px solid var(--v3-border-subtle);
  }
</style>
