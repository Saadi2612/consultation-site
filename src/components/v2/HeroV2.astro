---
import { site } from "../../lib/site";
---

<section class="v2-hero" id="top" aria-labelledby="v2-hero-title">
  <div class="v2-container v2-hero-grid">
    <div class="v2-hero-copy">
      <p class="v2-eyebrow" data-v2-hero-item>Two founders. No bench. {site.city}.</p>

      <h1 class="v2-hero-title" id="v2-hero-title" data-v2-hero-item>
        Where is your product right now?
      </h1>

      <p class="v2-hero-sub" data-v2-hero-item>
        Know the problem but not the spec, spec ready but nothing built, or
        live and breaking under load — we scope it, build it, or make it
        stable, on your working hours from Lahore.
      </p>

      <div class="v2-hero-cta" data-v2-hero-item>
        <a class="v2-btn v2-btn-primary v2-focus" href={site.booking} target="_blank" rel="noreferrer">
          Tell us where you are <span class="v2-arrow" aria-hidden="true">→</span>
        </a>
        <a class="v2-btn v2-btn-secondary v2-focus" href="#process">See how we work</a>
      </div>

      <ul class="v2-hero-trust" data-v2-hero-item>
        <li>
          <span class="v2-check" aria-hidden="true">✓</span>
          <div>
            <p class="v2-trust-h">Replies within 24 hours</p>
            <p class="v2-trust-b">Whenever you send it, not on a support queue</p>
          </div>
        </li>
        <li>
          <span class="v2-check" aria-hidden="true">✓</span>
          <div>
            <p class="v2-trust-h">Milestone ownership</p>
            <p class="v2-trust-b">Code is yours the moment you pay for it</p>
          </div>
        </li>
        <li>
          <span class="v2-check" aria-hidden="true">✓</span>
          <div>
            <p class="v2-trust-h">NDA before the idea</p>
            <p class="v2-trust-b">We send ours; you don't need to produce one</p>
          </div>
        </li>
      </ul>
    </div>

    <div class="v2-hero-visual" data-v2-hero-item aria-hidden="true">
      <div class="v2-blob"></div>
      <div class="v2-dots"></div>

      <div class="v2-float v2-float-a">
        <span class="v2-live-dot"></span>
        <div>
          <p class="v2-float-label">Response time</p>
          <p class="v2-float-value">Within 24 hrs</p>
        </div>
      </div>

      <div class="v2-dash">
        <div class="v2-dash-rail">
          <span class="v2-rail-icon is-active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
          </span>
          <span class="v2-rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          </span>
          <span class="v2-rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12v16l-6-4-6 4Z" /></svg>
          </span>
          <span class="v2-rail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 5-2 6-2 6h16s-2-1-2-6" /><path d="M10 20a2 2 0 0 0 4 0" /></svg>
          </span>
        </div>

        <div class="v2-dash-main">
          <p class="v2-dash-title">Engagement status</p>

          <div class="v2-dash-stats">
            <div class="v2-stat-card">
              <p class="v2-dash-stat-label">Weeks elapsed</p>
              <p class="v2-dash-stat-value">3 of 7</p>
              <svg class="v2-sparkline" viewBox="0 0 80 28" fill="none" preserveAspectRatio="none">
                <polyline points="0,22 14,20 28,16 42,17 56,10 70,8 80,4" stroke="var(--v2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div class="v2-stat-card">
              <p class="v2-dash-stat-label">Milestones done</p>
              <p class="v2-dash-stat-value">1 of 4</p>
              <div class="v2-minibars" aria-hidden="true">
                <span class="is-on"></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>

          <table class="v2-dash-table">
            <thead>
              <tr>
                <th scope="col">Task</th>
                <th scope="col">Status</th>
                <th scope="col">Owner</th>
                <th scope="col">Due</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Written scope</td>
                <td><span class="v2-pill v2-pill-done">Done</span></td>
                <td class="v2-owner"><span class="v2-avatar" data-initial="S"></span>Saad</td>
                <td>Week 1</td>
              </tr>
              <tr>
                <td>MVP build (v0)</td>
                <td><span class="v2-pill v2-pill-live">In progress</span></td>
                <td class="v2-owner"><span class="v2-avatar" data-initial="M"></span>Mohib</td>
                <td>Week 3</td>
              </tr>
              <tr>
                <td>Hardening sprint (v1)</td>
                <td><span class="v2-pill v2-pill-queued">Queued</span></td>
                <td class="v2-owner"><span class="v2-avatar" data-initial="S"></span>Saad</td>
                <td>Week 5</td>
              </tr>
              <tr>
                <td>Handover &amp; credentials</td>
                <td><span class="v2-pill v2-pill-queued">Queued</span></td>
                <td class="v2-owner"><span class="v2-avatar" data-initial="M"></span>Mohib</td>
                <td>Week 7</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="v2-float v2-float-b">
        <p class="v2-float-label">Milestone billing</p>
        <p class="v2-float-value">Paid as each piece ships</p>
        <svg class="v2-sparkline v2-sparkline-b" viewBox="0 0 90 26" fill="none" preserveAspectRatio="none">
          <polyline points="0,20 15,21 30,14 45,16 60,7 75,9 90,3" stroke="var(--v2-dark)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .v2-hero {
    padding-block: clamp(64px, 10vw, 130px) clamp(48px, 7vw, 90px);
  }

  .v2-hero-grid {
    display: grid;
    gap: 56px;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .v2-hero-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 64px;
    }
  }

  .v2-hero-title {
    max-width: 13ch;
    font-size: var(--v2-text-hero);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .v2-hero-sub {
    max-width: 470px;
    margin-top: 24px;
    color: var(--v2-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .v2-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .v2-hero-trust {
    display: grid;
    gap: 18px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .v2-hero-trust {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 20px;
    }
  }

  .v2-hero-trust li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .v2-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--v2-accent);
    color: var(--v2-dark);
    font-size: 0.6875rem;
  }

  .v2-trust-h {
    font-size: var(--v2-text-small);
    font-weight: 600;
  }

  .v2-trust-b {
    font-size: 0.8125rem;
    color: var(--v2-muted);
    margin-top: 2px;
  }

  /* --- hero item stagger, driven by the entrance module -------------- */

  [data-v2-hero-item] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 800ms var(--v2-ease), transform 800ms var(--v2-ease);
  }

  [data-v2-hero-item].is-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- product visual -------------------------------------------------- */

  .v2-hero-visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 560px;
    padding: 40px 20px;
  }

  /* --- background decoration: static, no gradient, low opacity ------- */

  .v2-blob {
    position: absolute;
    z-index: 0;
    top: -10%;
    right: -8%;
    width: 60%;
    aspect-ratio: 1;
    background: var(--v2-accent);
    opacity: 0.55;
    border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%;
    filter: blur(2px);
  }

  .v2-dots {
    position: absolute;
    z-index: 0;
    top: 4%;
    left: 0;
    width: 96px;
    height: 96px;
    opacity: 0.5;
    background-image: radial-gradient(var(--v2-border) 1.4px, transparent 1.4px);
    background-size: 14px 14px;
  }

  .v2-dash {
    position: relative;
    z-index: 1;
    display: flex;
    background: var(--v2-white);
    border: 1px solid var(--v2-border);
    border-radius: 22px;
    box-shadow: var(--v2-shadow-lg);
    overflow: hidden;
    animation: v2-float-dash 6.5s var(--v2-ease) infinite;
  }

  .v2-dash-rail {
    display: none;
  }

  @media (min-width: 480px) {
    .v2-dash-rail {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      flex: none;
      width: 52px;
      padding-block: 20px;
      border-right: 1px solid var(--v2-border);
      background: var(--v2-bg);
    }
  }

  .v2-rail-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    color: var(--v2-muted);
  }

  .v2-rail-icon svg {
    width: 16px;
    height: 16px;
  }

  .v2-rail-icon.is-active {
    background: var(--v2-white);
    color: var(--v2-ink);
    box-shadow: var(--v2-shadow-card);
  }

  .v2-dash-main {
    flex: 1;
    min-width: 0;
    padding: 24px;
  }

  .v2-dash-title {
    font-size: var(--v2-text-h3);
    font-weight: 650;
    margin-bottom: 18px;
  }

  .v2-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: var(--v2-radius-pill);
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .v2-pill-done {
    background: var(--v2-accent);
    color: var(--v2-dark);
  }

  .v2-pill-live {
    background: var(--v2-cta-panel);
    color: var(--v2-ink);
    border: 1px solid var(--v2-border);
  }

  .v2-pill-queued {
    background: transparent;
    color: var(--v2-muted);
    border: 1px solid var(--v2-border);
  }

  .v2-dash-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .v2-stat-card {
    position: relative;
    padding: 14px;
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius-sm);
    overflow: hidden;
  }

  .v2-dash-stat-label {
    font-size: 0.75rem;
    color: var(--v2-muted);
  }

  .v2-dash-stat-value {
    margin-top: 4px;
    font-size: 1.0625rem;
    font-weight: 650;
  }

  .v2-sparkline {
    display: block;
    width: 100%;
    height: 26px;
    margin-top: 8px;
  }

  .v2-minibars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 26px;
    margin-top: 8px;
  }

  .v2-minibars span {
    flex: 1;
    height: 40%;
    border-radius: 2px;
    background: var(--v2-border);
  }

  .v2-minibars span.is-on {
    height: 100%;
    background: var(--v2-dark);
  }

  .v2-dash-table {
    width: 100%;
    border-collapse: collapse;
  }

  .v2-dash-table th,
  .v2-dash-table td {
    text-align: left;
    padding-block: 10px;
    font-size: 0.8125rem;
  }

  .v2-dash-table thead th {
    color: var(--v2-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    border-bottom: 1px solid var(--v2-border);
  }

  .v2-dash-table tbody tr + tr td {
    border-top: 1px solid var(--v2-border);
  }

  .v2-dash-table th:nth-child(3),
  .v2-dash-table td:nth-child(3),
  .v2-dash-table th:nth-child(4),
  .v2-dash-table td:nth-child(4) {
    display: none;
  }

  @media (min-width: 560px) {
    .v2-dash-table th:nth-child(3),
    .v2-dash-table td:nth-child(3) {
      display: table-cell;
    }
  }

  @media (min-width: 640px) {
    .v2-dash-table th:nth-child(4),
    .v2-dash-table td:nth-child(4) {
      display: table-cell;
    }
  }

  .v2-owner {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .v2-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 50%;
    background: var(--v2-accent);
    color: var(--v2-dark);
    font-size: 0.625rem;
    font-weight: 700;
  }

  .v2-avatar::before {
    content: attr(data-initial);
  }

  .v2-float {
    position: absolute;
    z-index: 2;
    display: none;
    background: var(--v2-white);
    border: 1px solid var(--v2-border);
    border-radius: var(--v2-radius-card);
    box-shadow: var(--v2-shadow-lg);
    padding: 14px 18px;
    animation: v2-float-card 5.5s var(--v2-ease) infinite;
  }

  .v2-float-label {
    font-size: 0.6875rem;
    color: var(--v2-muted);
  }

  .v2-float-value {
    margin-top: 2px;
    font-size: 0.9375rem;
    font-weight: 650;
  }

  .v2-float-a {
    align-items: center;
    gap: 10px;
    top: 4px;
    right: 4px;
    animation-delay: 0.3s;
  }

  .v2-live-dot {
    position: relative;
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--v2-dark);
  }

  .v2-live-dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--v2-dark);
    opacity: 0.4;
    animation: v2-live-pulse 2.2s var(--v2-ease) infinite;
  }

  .v2-float-b {
    top: 158px;
    left: -36px;
    width: 140px;
    animation-delay: 1.1s;
  }

  .v2-sparkline-b {
    height: 24px;
  }

  @keyframes v2-live-pulse {
    0% {
      transform: scale(0.7);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .v2-float {
      display: block;
    }

    .v2-float-a {
      display: flex;
    }
  }

  @keyframes v2-float-dash {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes v2-float-card {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-dash,
    .v2-float,
    .v2-live-dot::after {
      animation: none;
    }
  }
</style>
