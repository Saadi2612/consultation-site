---
import { site } from "../../lib/site";

/* SPEC §9: every starting figure sits next to the scope it buys, at the same
   visual weight, and the consultation shows its typical total. */
const tiers = [
  {
    name: "Consultation",
    figure: "$35",
    unit: " an hour",
    total: "A typical two week scope is 20 to 30 hours, $700 to $1,050",
    buys:
      "Two weeks of questions and a written scope: feature list, exclusions with reasons, stack, sequence, timeline and price assumptions. Yours whether or not we build it.",
    cta: "Book the call",
    href: site.booking,
  },
  {
    name: "MVP development",
    figure: "$3,499",
    unit: " to start",
    total: "6 to 8 weeks for a full v0",
    buys:
      "A web app or a React Native app for iOS and Android: one core workflow, accounts, payments if you charge, transactional email, an admin view, deploys and error reporting. Shipped to real users.",
    cta: "Start a build",
    href: "#v4-contact",
    featured: true,
  },
  {
    name: "Product hardening",
    figure: "$1,999",
    unit: " to start",
    total: "Four weeks on a live product",
    buys:
      "Bug fixing, automated tests, a security pass, performance work and safe deploys on your live product. Four agreed numbers moved and reported weekly, plus a runbook that keeps them there.",
    cta: "Stabilise my product",
    href: "#v4-contact",
  },
];

const pushers = [
  "How many screens your users see, and on how many platforms",
  "How many outside integrations have to work on day one",
  "Whether an existing codebase has to be read and understood first",
  "Compliance requirements such as SOC 2, HIPAA or GDPR data residency",
  "How much design already exists, and whether it survives contact with the build",
];
---

<section class="v4-section v4-section--tint" id="v4-pricing" aria-labelledby="v4-pricing-title">
  <div class="v4-container">
    <div class="v4-pricing__head">
      <p class="v4-eyebrow" data-v4-reveal>Pricing for software development</p>
      <h2 class="v4-h2" id="v4-pricing-title" data-v4-reveal data-v4-delay="60">
        Clear starting prices, and exactly what each one buys.
      </h2>
    </div>

    <div class="v4-prices" data-v4-group data-v4-step="90">
      {
        tiers.map((tier) => (
          <article
            class:list={["v4-card", "v4-price", tier.featured && "v4-price--featured"]}
            data-v4-group-item
          >
            <h3 class="v4-h5">{tier.name}</h3>
            <p class="v4-price__figure v4-num">
              {tier.figure}
              <span class="v4-price__unit">{tier.unit}</span>
            </p>
            <span class="v4-price__rule" aria-hidden="true" />
            <p class="v4-small v4-price__total v4-num">{tier.total}</p>
            <p class="v4-body v4-price__buys">{tier.buys}</p>
            <a class="v4-btn v4-btn--secondary v4-btn--sm v4-price__cta" href={tier.href}>
              {tier.cta}
            </a>
          </article>
        ))
      }
    </div>

    <div class="v4-pricing__foot">
      <div data-v4-reveal>
        <h3 class="v4-h4">What pushes a quote above the starting figure</h3>
        <ul class="v4-pushers">
          {pushers.map((item) => <li class="v4-pushers__item">{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
