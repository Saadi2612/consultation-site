---
/* SPEC §11: real objections, answered directly. The list lives in lib/faq.ts
   so the FAQPage structured data reads the same words. */
import { faqs } from "../../lib/faq";
---

<section class="v4-section" id="v4-faq" aria-labelledby="v4-faq-title">
  <div class="v4-container v4-split">
    <div class="v4-split__head">
      <p class="v4-eyebrow" data-v4-reveal>Frequently asked questions</p>
      <h2 class="v4-h2" id="v4-faq-title" data-v4-reveal data-v4-delay="60">
        What founders ask us before they sign.
      </h2>
    </div>

    <div class="v4-faq" data-v4-reveal>
      {
        faqs.map((faq, i) => (
          <div class="v4-faq__item" data-v4-accordion-item data-open={i === 0 ? "true" : "false"}>
            <h3>
              <button
                class="v4-faq__trigger"
                type="button"
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`v4-faq-panel-${i}`}
                id={`v4-faq-trigger-${i}`}
                data-v4-accordion-trigger
              >
                <span>{faq.q}</span>
                <span class="v4-faq__chevron" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none">
                    <path
                      d="M4 6.5 8 10.5 12 6.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </button>
            </h3>
            <div
              class="v4-faq__panel"
              id={`v4-faq-panel-${i}`}
              role="region"
              aria-labelledby={`v4-faq-trigger-${i}`}
              data-v4-accordion-panel
            >
              <div class="v4-faq__panel-inner">
                <p class="v4-body">{faq.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
