---
import { Image } from "astro:assets";
import { site } from "../../lib/site";
import mohibPhoto from "../../assets/founders/mohib-photo.jpg";
import saadPhoto from "../../assets/founders/saad-photo.jpg";

/* The three positions are one instrument, not three cards. Every row stays
   legible with nothing selected; the selection only adds depth. */
const stages = [
  {
    id: "vq",
    marker: "v?",
    state: "You have the idea. You need a clear plan and a price.",
    service: "Consultation",
    span: "two weeks",
    deliverable: "A written product scope, technical plan and quote you can hand to any team.",
    price: "$35 an hour, usually 20 to 30 hours, so $700 to $1,050",
    cta: "Book the scoping call",
    href: site.booking,
  },
  {
    id: "v0",
    marker: "v0",
    state: "The plan is ready. Nothing is built yet.",
    service: "MVP development",
    span: "6 to 8 weeks",
    deliverable: "A working web or mobile MVP that real users can sign into and pay for.",
    price: "From $3,499",
    cta: "Plan your MVP",
    href: "#v4-contact",
  },
  {
    id: "v1",
    marker: "v1",
    state: "It is live, and it keeps breaking.",
    service: "Product hardening",
    span: "four weeks",
    deliverable: "Bugs fixed, every key flow tested, and a product ready to market.",
    price: "From $1,999",
    cta: "Stabilise my product",
    href: "#v4-contact",
  },
];

const holds = [
  ["Experience", "7+ years shipping web and mobile products"],
  ["Your hours", "9am to 5pm EST, Monday to Friday"],
  ["Your code", "Yours at every milestone, not at the end"],
];
---

<section class="v4-hero" aria-labelledby="v4-hero-title">
  <div class="v4-container v4-hero__grid">
    <div class="v4-hero__left">
      <p class="v4-eyebrow" data-v4-hero-item>Product hardening and full stack development</p>

      <h1 class="v4-display v4-hero__title" id="v4-hero-title">
        <span class="v4-wipe" data-v4-wipe><span class="v4-wipe__text">We make your</span></span>
        <span class="v4-wipe" data-v4-wipe><span class="v4-wipe__text">software stable,</span></span>
        <span class="v4-wipe" data-v4-wipe><span class="v4-wipe__text">tested and live.</span></span>
      </h1>

      <p class="v4-lead v4-hero__lead" data-v4-hero-item>
        Proofload is a two engineer software studio. For seven years we have
        built websites, web apps and iOS and Android apps, and repaired the ones
        that were already live and failing. Tell us where your product stands
        today and you get a starting price, a written deliverable and a finish
        date.
      </p>

      <div class="v4-hero__ctas" data-v4-hero-item>
        <a class="v4-btn v4-btn--primary v4-magnet" data-v4-magnet href={site.booking}>
          Book a 30 minute call
        </a>
        <a class="v4-btn v4-btn--secondary" href="#v4-rail">
          Find the right service
        </a>
      </div>

      <ul class="v4-holds" data-v4-hero-item>
        {
          holds.map(([term, detail]) => (
            <li class="v4-holds__item">
              <span class="v4-holds__tick" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
                  <path
                    d="M3 8.5 6.2 11.7 13 5"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <span>
                <span class="v4-holds__term">{term}</span>
                <span class="v4-holds__detail">{detail}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="v4-hero__right" data-v4-tilt-scene>
      <div class="v4-rail-card v4-card v4-card--elevated" id="v4-rail" data-v4-tilt>
        <div class="v4-rail-card__head">
          <h2 class="v4-h5">Where is your product today?</h2>
        </div>

        <div
          class="v4-rail"
          role="radiogroup"
          aria-label="Where your product is right now"
          data-v4-rail
        >
          {
            stages.map((stage, i) => (
              <div class="v4-stage" data-v4-stage={stage.id}>
                <button
                  class="v4-stage__button"
                  type="button"
                  role="radio"
                  aria-checked={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? "0" : "-1"}
                  data-v4-stage-button={stage.id}
                >
                  <span class="v4-stage__spine" aria-hidden="true" />
                  <span class="v4-stage__marker" aria-hidden="true">
                    {stage.marker}
                  </span>
                  <span class="v4-stage__copy">
                    <span class="v4-stage__state">{stage.state}</span>
                    <span class="v4-stage__service">
                      {stage.service}, {stage.span}
                    </span>
                  </span>
                </button>

                <div class="v4-stage__detail" data-v4-stage-detail>
                  <div class="v4-stage__detail-inner">
                    <p class="v4-stage__deliverable">{stage.deliverable}</p>
                    <p class="v4-stage__price v4-num">{stage.price}</p>
                    <a class="v4-btn v4-btn--dark v4-btn--sm" href={stage.href}>
                      {stage.cta}
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="v4-float v4-float--a" data-v4-float="1">
        <p class="v4-small v4-float__label">Working hours</p>
        <p class="v4-h5 v4-num">9am to 5pm EST</p>
        <p class="v4-small">A full US East Coast working day</p>
      </div>

      <div class="v4-float v4-float--b" data-v4-float="2">
        <div class="v4-team">
          <span class="v4-team__faces" aria-hidden="true">
            <Image src={mohibPhoto} alt="" width={96} height={96} class="v4-team__face" />
            <Image src={saadPhoto} alt="" width={96} height={96} class="v4-team__face" />
          </span>
          <span>
            <span class="v4-small v4-float__label v4-team__label">Your engineers</span>
            <span class="v4-h5 v4-team__names">Mohib and Saad</span>
          </span>
        </div>
        <p class="v4-small v4-team__note">{site.experience} in the market. No one else on the call.</p>
      </div>
    </div>
  </div>
</section>
