---
/* SPEC §7: the second column has to be genuinely disqualifying. */
const take = [
  "Founders and operators who can make a decision without a committee",
  "A live product that needs bug fixing, testing and stabilising before you market it",
  "Websites, web apps and iOS and Android apps on Next.js, React, React Native, Node.js and Django",
  "An existing codebase someone else wrote, as long as we can read it before we quote",
  "A budget that starts at $1,999 and a launch date you can name",
];

const turnDown = [
  ["Work under $1,500", "Below that, scoping costs more than the build returns, for you and for us."],
  ["Staff augmentation inside your sprint board", "We take outcomes with a date on them, not seats in a standup."],
  ["A rewrite with no way to run the old system", "If nobody can explain what the current system does, week one becomes archaeology and any estimate is fiction."],
  ["Fixed price work with no written scope", "A price without a scope is a guess. We write the scope first, then we commit to the number."],
];
---

<section class="v4-section" aria-labelledby="v4-fit-title">
  <div class="v4-container v4-split">
    <div class="v4-split__head">
      <p class="v4-eyebrow" data-v4-reveal>Who we work with</p>
      <h2 class="v4-h2" id="v4-fit-title" data-v4-reveal data-v4-delay="60">
        The projects we take on, and the ones we turn down.
      </h2>
      <p class="v4-body" data-v4-reveal data-v4-delay="120" style="margin-top: var(--v4-4)">
        We build and harden web and mobile products on Next.js, React, React
        Native, Node.js and Django, deployed on AWS. Saying no early is cheaper
        for both of us than a project that was never a fit.
      </p>
    </div>

    <div class="v4-fit">
      <div class="v4-fit__col v4-fit__col--take" data-v4-group data-v4-step="80">
        <h3 class="v4-h4 v4-table__head">
          Work we take
          <span class="v4-badge v4-badge--success">Yes</span>
        </h3>
        <ul>
          {
            take.map((item) => (
              <li class="v4-fit__row" data-v4-group-item>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="v4-fit__col v4-fit__col--turn" data-v4-group data-v4-step="80">
        <h3 class="v4-h4 v4-table__head">
          Work we turn down
          <span class="v4-badge v4-badge--warn">No</span>
        </h3>
        <ul>
          {
            turnDown.map(([item, why]) => (
              <li class="v4-fit__row" data-v4-group-item>
                <span class="v4-h5">{item}</span>
                <span class="v4-table__why">{why}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
