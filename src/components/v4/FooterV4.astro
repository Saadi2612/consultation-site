---
import { site } from "../../lib/site";

const services = [
  "Product hardening",
  "MVP development",
  "Web application development",
  "iOS and Android apps",
  "Website development",
  "DevOps and AI integrations",
];
---

<footer class="v4-footer">
  <div class="v4-container v4-footer__inner">
    <p class="v4-footer__line">Two engineers. Products that stay up.</p>

    <div class="v4-footer__cols">
      <div>
        <p class="v4-footer__head">Services</p>
        <ul class="v4-footer__list">
          {services.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div>
        <p class="v4-footer__head">Contact</p>
        <ul class="v4-footer__list">
          {
            site.emails.map((e) => (
              <li>
                {e.name}:{" "}
                <a class="v4-footer__link" href={`mailto:${e.address}`}>{e.address}</a>
              </li>
            ))
          }
          <li>
            <a class="v4-footer__link" href={site.booking}>Book a 30 minute call</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="v4-footer__head">Studio</p>
        <ul class="v4-footer__list">
          <li>Remote, working your hours</li>
          <li>Working {site.hours}, Monday to Friday</li>
          <li>Clients in the US, UK, Europe and Australia</li>
        </ul>
      </div>
    </div>

    <div class="v4-footer__meta">
      <a class="v4-wordmark v4-wordmark--invert" href="#v4-main">
        <span class="v4-wordmark__mark" aria-hidden="true"></span>
        {site.name}
      </a>
      <span class="v4-footer__place">© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
    </div>
  </div>
</footer>
