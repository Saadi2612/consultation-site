---
import { site } from "../../lib/site";

/* SPEC §8: the section that closes cross-border deals. Plain and specific. */
const blocks = [
  {
    h: "Contract and NDA",
    p: "We sign your NDA before the first call, and your contract if you have one. If you do not, we send a fixed scope agreement naming the deliverable, the milestones, the payment schedule and the termination terms. English law or your local jurisdiction, your choice. We have no preference to defend.",
  },
  {
    h: "IP assignment",
    p: "Everything we write is assigned to you on payment of the milestone it belongs to. No licence back, no shared ownership, no portfolio rights unless you separately agree to them in writing. Third party dependencies stay under their own open source licences, and we list them.",
  },
  {
    h: "Payment methods and currencies",
    p: "USD, GBP, EUR and AUD. Wise, Payoneer or a direct SWIFT transfer to our business account. Invoices are issued per milestone, net 7. We do not ask for the full amount up front, and we do not start the next milestone until the previous one is paid.",
  },
  {
    h: "Channels and cadence",
    p: "A shared Slack Connect channel or your Discord, plus email for anything that has to be findable in a year. One scheduled call a week between 9am and 5pm EST, and a written Friday note whether or not the call happens.",
  },
  {
    h: "If you go quiet",
    p: "We keep working through the current milestone, then stop and tell you the build is paused rather than billing into silence. Work already delivered stays yours. If you come back inside 60 days we pick up where we stopped at the same rate; after that we quote again, because the code has aged.",
  },
  {
    h: "Our hours, stated plainly",
    p: "We work 9am to 5pm EST, Monday to Friday. That is the full working day on the US East Coast, the morning and early afternoon on the US West Coast, and the afternoon in London and Berlin. Your weekly call goes inside those hours, and we tell you up front which of them suit your region.",
  },
];
---

<section class="v4-section" aria-labelledby="v4-borders-title">
  <div class="v4-container v4-split">
    <div class="v4-split__head">
      <p class="v4-eyebrow" data-v4-reveal>Hiring an offshore development team</p>
      <h2 class="v4-h2" id="v4-borders-title" data-v4-reveal data-v4-delay="60">
        Hiring a remote team, with the paperwork already answered.
      </h2>
      <p class="v4-body" data-v4-reveal data-v4-delay="120" style="margin-top: var(--v4-4)">
        Contracts, IP ownership, payments, communication and what happens if something goes wrong. Written down here so you can decide before the first call.
      </p>
    </div>

    <div class="v4-borders">
      {
        blocks.map((block, i) => (
          <div class="v4-borders__block" data-v4-reveal data-v4-delay={i * 60}>
            <h3 class="v4-h5">{block.h}</h3>
            <p class="v4-body" style="margin-top: var(--v4-2)">{block.p}</p>
          </div>
        ))
      }

      <p class="v4-small v4-borders__foot" data-v4-reveal>
        Anything here you need in your own paperwork instead, mail Mohib at{" "}
        <a class="v4-link" href={`mailto:${site.emails[0].address}`}>{site.emails[0].address}</a>{" "}
        or Saad at{" "}
        <a class="v4-link" href={`mailto:${site.emails[1].address}`}>{site.emails[1].address}</a>{" "}
        and we will work from your documents.
      </p>
    </div>
  </div>
</section>
