---
/** Four operating facts, all of them confirmed by Mohib and Saad. */
const facts = [
  {
    label: "Overlap",
    value:
      "Four hours of your working day, every working day. Eight if you are in the UK or the EU.",
  },
  {
    label: "Replies",
    value: "Within 24 hours, whenever you send it.",
  },
  {
    label: "Code ownership",
    value:
      "Each milestone is yours the moment you pay for it, not at the end of the build.",
  },
  {
    label: "NDAs",
    value: "We send you our own mutual NDA. You do not have to produce one.",
  },
];
---

<section class="section facts" aria-labelledby="facts-title">
  <div class="shell split sticky-split">
    <h2 class="section-title" id="facts-title">Four things you can hold us to.</h2>

    <dl class="facts-list" data-entrance>
      {
        facts.map((fact, i) => (
          <div class="fact enter-rise" style={`--i: ${i}`}>
            <dt class="fact-label">{fact.label}</dt>
            <dd class="fact-value">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts-list {
    margin: 0;
  }

  /* A ledger, not four boxes. The rules are the only structure. */
  .fact {
    display: grid;
    row-gap: 6px;
    padding-block: 20px;
    border-top: 1px solid var(--rule);
  }

  .fact:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .fact-label {
    color: var(--muted);
    font-size: var(--text-body);
    font-weight: 500;
  }

  .fact-value {
    margin: 0;
    max-width: 42ch;
    font-size: var(--text-h3);
    line-height: 1.35;
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .fact {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 1.5fr);
      column-gap: 32px;
      row-gap: 0;
      padding-block: 24px;
    }

    .fact-label {
      padding-top: 0.25rem;
    }
  }
</style>
