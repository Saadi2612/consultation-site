---
/**
 * The four measures from SPEC.md, with the figures from the hardening
 * engagement written up further down the page. Illustrative, and labelled as
 * such directly under the heading rather than in small print.
 */
const measures = [
  {
    name: "p95 API response",
    before: "2.4 seconds at peak",
    after: "Under 300ms",
  },
  {
    name: "Error rate",
    before: "Around 3%",
    after: "Under 0.5%",
  },
  {
    name: "Tests",
    before: "No test suite",
    after: "140 integration tests on the booking path",
  },
  {
    name: "Deploys",
    before: "Monthly, by hand over SSH",
    after: "Daily, automated",
  },
];

const heads = ["On arrival", "After four weeks"];
---

<section class="section" id="hardening" aria-labelledby="hardening-title">
  <div class="shell split">
    <h2 class="section-title" id="hardening-title">
      Four numbers have to move before we call it stable.
    </h2>

    <div class="readout">
      <p class="readout-note">
        These figures are illustrative. They come from one engagement, not from
        an average, and yours start somewhere else.
      </p>

      <table class="measures">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Measure</span></th>
            {heads.map((head) => <th scope="col">{head}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            measures.map((measure) => (
              <tr>
                <th class="measure-name" scope="row">
                  {measure.name}
                </th>
                <td class="measure-before">
                  <span class="cell-label">{heads[0]}</span>
                  {measure.before}
                </td>
                <td class="measure-after">
                  <span class="cell-label">{heads[1]}</span>
                  {measure.after}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- .readout, .measures and .cell-label live in global.css — section 6 reuses
     this exact shape for the hardening worked example. No component-scoped
     styles needed. -->
