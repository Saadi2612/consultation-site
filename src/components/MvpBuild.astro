---
/**
 * The right-hand column is the point of this section, so it carries the ink
 * while the left column sits back in --muted.
 */
const scope = [
  {
    ships: "One way to sign in.",
    cut: "Social logins and SSO. Each one is an integration to keep working, and none of them tells you whether people want the product.",
  },
  {
    ships: "The single flow the product is paid for.",
    cut: "The second and third flows. They are cheaper to build once you have watched people use the first one.",
  },
  {
    ships: "Card payments, if money changes hands in v0.",
    cut: "Multiple currencies, self-service refunds, invoicing. Do these by hand until the volume hurts.",
  },
  {
    ships: "The emails the product cannot work without.",
    cut: "Digests, notification preferences, in-app messaging. Nobody leaves in month one over a missing digest.",
  },
  {
    ships: "A web app that works in a phone browser.",
    cut: "Native iOS and Android. Two more pipelines and two more review queues, for an audience you have not measured.",
  },
  {
    ships: "Enough logging to debug a live problem.",
    cut: "An analytics dashboard. Query the database directly until the same question comes up for the fourth time.",
  },
];

const heads = ["Ships in v0", "Left out of v0, and why"];
// Shorter on the stacked layout, where each label repeats once per row.
const stacked = ["Ships", "Cut, and why"];
---

<section class="section" id="mvp" aria-labelledby="mvp-title">
  <div class="shell split">
    <h2 class="section-title" id="mvp-title">
      Half of scoping a v0 is deciding what not to build.
    </h2>

    <table class="scope">
      <thead>
        <tr>
          {heads.map((head) => <th scope="col">{head}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          scope.map((row) => (
            <tr>
              <td class="scope-ships">
                <span class="cell-label">{stacked[0]}</span>
                {row.ships}
              </td>
              <td class="scope-cut">
                <span class="cell-label">{stacked[1]}</span>
                {row.cut}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<!-- .scope and .cell-label live in global.css — section 6 reuses this exact
     shape for the MVP worked example. No component-scoped styles needed. -->
