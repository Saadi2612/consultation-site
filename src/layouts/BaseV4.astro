---
import "../styles/v4.css";
import { site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  /** Keep a backup copy of the page out of search results. */
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />
    <meta name="author" content="Mohib and Saad, Proofload" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <meta name="theme-color" content="#15191e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /* Set before first paint: every entrance pre-state is scoped to this
         class, so with scripting off the page renders fully resolved. */
      document.documentElement.classList.add("v4-js");
    </script>
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="v4">
    <a class="v4-skip" href="#v4-main">Skip to content</a>
    <div class="v4-progress" data-v4-progress aria-hidden="true"></div>
    <slot />
  </body>
</html>

<script>
  import { initV4 } from "../scripts/v4-motion";

  initV4();
</script>
