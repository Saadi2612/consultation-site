---
import "../styles/v5.css";
import { site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Let search engines index this page. Only the page served at the root does. */
  index?: boolean;
  jsonLd?: object[];
}

const { title, description, index = false, jsonLd = [] } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? "index, follow" : "noindex"} />
    <meta name="author" content="Mohib and Saad, Proofload" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /* Entrance pre-states are scoped to this class, so with scripting off
         the page renders fully resolved. */
      document.documentElement.classList.add("v5-js");
    </script>
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="v5">
    <slot />
  </body>
</html>

<script>
  /* Once-only entrances. Each element opts in with data-v5-reveal (its
     treatment is set in CSS by the attribute value) and stops being
     watched the moment it arrives. */
  const items = document.querySelectorAll<HTMLElement>("[data-v5-reveal]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-in"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.querySelectorAll<HTMLElement>("[data-v5-stagger] > *").forEach((kid, i) => {
            kid.style.transitionDelay = `${i * 80}ms`;
          });
          el.classList.add("is-in");
          io.unobserve(el);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
    );
    items.forEach((el) => io.observe(el));
  }

  /* A soft glow under the pointer on every small text box, following it
     while it moves. One delegated listener for the whole page; fine
     pointers only, and never with reduced motion. */
  const GLOW = ".v5-card, .v5-step, .v5-example, .v5-project, .v5-stats__item, .v5-quote, .v5-handover, .v5-work__cta";
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>(GLOW).forEach((el) => el.classList.add("v5-glow"));
    let lit: HTMLElement | null = null;
    let frame = 0;
    document.addEventListener("pointermove", (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>(".v5-glow") ?? null;
      if (target !== lit) {
        lit?.classList.remove("is-glowing");
        target?.classList.add("is-glowing");
        lit = target;
      }
      if (!target) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = target.getBoundingClientRect();
        target.style.setProperty("--glow-x", `${event.clientX - box.left}px`);
        target.style.setProperty("--glow-y", `${event.clientY - box.top}px`);
      });
    });
    document.addEventListener("pointerleave", () => {
      lit?.classList.remove("is-glowing");
      lit = null;
    });
  }
</script>
