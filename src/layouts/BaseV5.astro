---
import "../styles/v5.css";
import { site } from "../lib/site";

interface Props {
  title: string;
  description: string;
  /** Let search engines index this page. Only the page served at the root does. */
  index?: boolean;
  jsonLd?: object[];
}

const { title, description, index = false, jsonLd = [] } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={index ? "index, follow" : "noindex"} />
    <meta name="author" content="Mohib and Saad, Proofload" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /* Entrance pre-states are scoped to this class, so with scripting off
         the page renders fully resolved. */
      document.documentElement.classList.add("v5-js");
    </script>
    <link
      rel="preload"
      href="/fonts/rubik-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="v5">
    <slot />
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /* Once-only entrances. Each element opts in with data-v5-reveal (its
     treatment is set in CSS by the attribute value) and stops being
     watched the moment it arrives. */
  const items = document.querySelectorAll<HTMLElement>("[data-v5-reveal]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce || !("IntersectionObserver" in window)) {
    items.forEach((el) => el.classList.add("is-in"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.querySelectorAll<HTMLElement>("[data-v5-stagger] > *").forEach((kid, i) => {
            kid.style.transitionDelay = `${i * 80}ms`;
          });
          el.classList.add("is-in");
          io.unobserve(el);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
    );
    items.forEach((el) => io.observe(el));
  }

  /* A soft glow under the pointer on every small text box, following it
     while it moves. One delegated listener for the whole page; fine
     pointers only, and never with reduced motion. */
  const GLOW = ".v5-card, .v5-step, .v5-example, .v5-project, .v5-stats__item, .v5-quote, .v5-handover, .v5-work__cta";
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>(GLOW).forEach((el) => el.classList.add("v5-glow"));
    let lit: HTMLElement | null = null;
    let frame = 0;
    document.addEventListener("pointermove", (event) => {
      const target = (event.target as Element | null)?.closest<HTMLElement>(".v5-glow") ?? null;
      if (target !== lit) {
        lit?.classList.remove("is-glowing");
        target?.classList.add("is-glowing");
        lit = target;
      }
      if (!target) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const box = target.getBoundingClientRect();
        target.style.setProperty("--glow-x", `${event.clientX - box.left}px`);
        target.style.setProperty("--glow-y", `${event.clientY - box.top}px`);
      });
    });
    document.addEventListener("pointerleave", () => {
      lit?.classList.remove("is-glowing");
      lit = null;
    });
  }

  /* Each selected work screenshot starts zoomed in and low, then settles
     and drifts up as its card scrolls through the viewport, scrubbed to
     the scroll position. The media box clips the overflow. */
  if (!reduce) {
    document.querySelectorAll<HTMLElement>(".v5-project").forEach((card) => {
      const image = card.querySelector<HTMLElement>(".v5-project__img");
      const media = card.querySelector<HTMLElement>(".v5-project__media");
      if (!image || !media) return;
      /* Progress runs 0 to 1 as the frame crosses the viewport, so 0.5 is
         the centre of the page: y is 0 and the zoom has finished there. */
      gsap
        .timeline({ defaults: { ease: "none" }, scrollTrigger: { trigger: media, scrub: true } })
        .fromTo(image, { y: 30 }, { y: -30, duration: 1 }, 0)
        .fromTo(image, { scale: 1.3 }, { scale: 1, duration: 0.5 }, 0);
    });
  }
</script>
