---
import "../styles/v5.css";

interface Props {
  title: string;
  description: string;
  /** Let search engines index this page. Only the page served at the root does. */
  index?: boolean;
}

const { title, description, index = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="v5">
    <slot />
  </body>
</html>
