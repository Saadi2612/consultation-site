---
import BaseV5 from "../layouts/BaseV5.astro";
import NavbarV5 from "../components/v5/NavbarV5.astro";
import HeroV5 from "../components/v5/HeroV5.astro";
import ClientsV5 from "../components/v5/ClientsV5.astro";
import FactsV5 from "../components/v5/FactsV5.astro";
import ServicesV5 from "../components/v5/ServicesV5.astro";
import HardeningV5 from "../components/v5/HardeningV5.astro";
import ConsultationV5 from "../components/v5/ConsultationV5.astro";
import MvpV5 from "../components/v5/MvpV5.astro";
import EngagementV5 from "../components/v5/EngagementV5.astro";
import ExamplesV5 from "../components/v5/ExamplesV5.astro";
import FitV5 from "../components/v5/FitV5.astro";
import BordersV5 from "../components/v5/BordersV5.astro";
import PricingV5 from "../components/v5/PricingV5.astro";
import FoundersV5 from "../components/v5/FoundersV5.astro";
import FaqV5 from "../components/v5/FaqV5.astro";
import ContactV5 from "../components/v5/ContactV5.astro";
import FooterV5 from "../components/v5/FooterV5.astro";
import { site } from "../lib/site";
import { faqs } from "../lib/faq";

const title =
  "Product hardening, MVP development and full stack engineering | Proofload";
const description =
  "Proofload fixes, tests and stabilises live web and mobile products, and builds MVPs, web apps and iOS and Android apps in Next.js, React Native, Node.js and Django. 7+ years of experience.";

/* Structured data: who we are, what we sell at what starting price, and the
   FAQ in the exact words shown on the page. */
const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description,
  ...(site.url ? { url: site.url } : {}),
  email: site.email,
  areaServed: ["United States", "United Kingdom", "European Union", "Australia"],
  address: { "@type": "PostalAddress", addressLocality: "Lahore", addressCountry: "PK" },
  founder: site.emails.map((e) => ({
    "@type": "Person",
    name: e.name,
    email: e.address,
    jobTitle: "Full stack engineer",
  })),
  knowsAbout: [
    "Product hardening",
    "MVP development",
    "Web application development",
    "iOS app development",
    "Android app development",
    "React Native",
    "Next.js",
    "Node.js",
    "Django",
    "DevOps",
    "AI integration",
  ],
  makesOffer: [
    ["Software consultation", "35", "Two week product scoping, billed hourly"],
    ["MVP development", "3499", "A web or mobile MVP in six to eight weeks"],
    ["Product hardening", "1999", "Four weeks of bug fixing, testing and stabilising a live product"],
  ].map(([name, price, desc]) => ({
    "@type": "Offer",
    priceCurrency: "USD",
    price,
    itemOffered: { "@type": "Service", name, description: desc },
  })),
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseV5 title={title} description={description} index jsonLd={[org, faqLd]}>
  <NavbarV5 />
  <main>
    <HeroV5 />
    <ClientsV5 />
    <FactsV5 />
    <ServicesV5 />
    <HardeningV5 />
    <ConsultationV5 />
    <MvpV5 />
    <EngagementV5 />
    <ExamplesV5 />
    <FitV5 />
    <BordersV5 />
    <PricingV5 />
    <FoundersV5 />
    <FaqV5 />
    <ContactV5 />
  </main>
  <FooterV5 />
</BaseV5>
